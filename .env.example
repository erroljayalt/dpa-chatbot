# Copy this file to .env.local and fill in your keys.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Required — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional backup when Gemini's free limit is reached — free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
